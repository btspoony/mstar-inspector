{
  // T1 smoke config (plan 06 Task 1, STOP gate) — dedicated entry
  // src/pipeline/smoke-entry.ts. NOT the production config: the production
  // worker (src/worker/index.ts) gains the consumer + sandbox wiring at T3.
  // Binding shape verified against @cloudflare/sandbox 0.12.8 docs + types:
  //   containers[].class_name == durable_objects.bindings[].class_name ==
  //   migrations[].new_sqlite_classes[0] == "Sandbox" (the SDK's DO class).
  "name": "mstar-inspector-smoke",
  "main": "src/pipeline/smoke-entry.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./sandbox-image/Dockerfile",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "SANDBOX"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v1"
    }
  ]
}
