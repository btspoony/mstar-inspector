{
  // T1/T2 smoke config — dedicated entry src/pipeline/smoke-entry.ts.
  // NOT the production config: the production worker (src/worker/index.ts)
  // gains the consumer + sandbox wiring at T3.
  // Sandbox SDK 1.0 shape (mirrors wrangler.jsonc): containers[].class_name ==
  // durable_objects.bindings[].class_name == migrations[].new_sqlite_classes[0]
  // == "Sandbox" (the in-repo DO in src/pipeline/sandbox.ts); the DO starts its
  // own container, so `scheduling_policy: "durable_object"` + named `images`
  // (container.images.sandbox). build_context "." = repo root, so the
  // Dockerfile can COPY package.json/bun.lock and src/review into the image.
  "name": "mstar-inspector-smoke",
  "main": "src/pipeline/smoke-entry.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "Sandbox",
      "name": "mstar-inspector-smoke-sandbox-v2",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": {
          "dockerfile": "./sandbox-image/omp/Dockerfile",
          "build_context": "."
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "SANDBOX"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v1"
    }
  ]
}
