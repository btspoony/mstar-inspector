# GitHub App credentials — fill locally in .env / .dev.vars (never commit real values).
# APP_ID / PRIVATE_KEY / WEBHOOK_SECRET are read from the Worker environment only.
# On the deployed Worker they are set with `wrangler secret put` (see
# .mstar/iterations/v0.2/guides/github-app-runbook.md); for local `wrangler dev`
# they go in .dev.vars (gitignored).
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=
# WEBHOOK_SECRET is REQUIRED: the Worker rejects webhooks when it is empty
# or set to the default "development" (fail-closed, see src/worker/webhooks.ts).
#
# PRIVATE_KEY forms (see runbook):
#   (a) inline PEM — paste the whole multi-line key (PKCS#1 or PKCS#8);
#   (b) file path — e.g. ~/local/keys/github/<app>.private-key.pem (local dev only;
#       the deployed Workers runtime has no filesystem — use inline PEM there).

# Fail-closed kill-switch (postdeploy feedback T4): reviews run ONLY when this
# is exactly "true". Unset or any other value → every webhook is ignored with
# HTTP 2xx and nothing is enqueued. Default OFF — leave unset until go-live.
REVIEW_ENABLED=

# omp review model chain (postdeploy feedback T2 / bugbot PR-3 BB-1):
# comma-separated model selectors. The FIRST selector is the primary review
# model; the full list is injected as the session's retry.fallbackChains.default
# with retry.modelFallback: true (failed turns fall back through the rest).
# Unset → ark-plan/deepseek-v4-flash with no fallback chain.
# Read from the Worker env and forwarded into the review container's exec env
# by the queue consumer (set on the Worker; .dev.vars for local wrangler dev).
# OMP_REVIEW_MODEL=ark-plan/deepseek-v4-flash,openrouter/anthropic/claude-sonnet-4

# omp model key for the primary provider (injected into the review container
# as ARK_API_KEY via exec env — never in the image, never in git).
# OMP_MODEL_KEY=

# omp built-in provider API keys (bugbot PR-3 BB-2): set on the deployed
# Worker with `bun run keys` → wrangler secret put (see README "Setting
# provider keys"). The queue consumer forwards every known provider key that
# is present and non-empty on the Worker into the review container, so
# fallback providers can authenticate. Keys set only locally (shell / .dev.vars
# without a matching Worker secret) never reach reviews. `wrangler dev` reads
# them from .dev.vars.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# COPILOT_GITHUB_TOKEN=
# AZURE_OPENAI_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# KILO_API_KEY=
# MISTRAL_API_KEY=
# ZAI_API_KEY=
# UMANS_AI_CODING_PLAN_API_KEY=
# MINIMAX_API_KEY=
# OPENCODE_API_KEY=
# CURSOR_ACCESS_TOKEN=
# AI_GATEWAY_API_KEY=
# WAFER_SERVERLESS_API_KEY=

# mstar-harness plugin root inside the review container (image default).
# HARNESS_PLUGIN_ROOT=/opt/mstar-harness

# Minimal permission set for the GitHub App (documentation only — not env keys):
#   pull_requests: read/write
#   contents: read
#   metadata: read
#   issues: read/write
# Webhook events subscribed: pull_request, issue_comment
