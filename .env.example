# GitHub App credentials — fill locally in .env (never commit real values).
# APP_ID / PRIVATE_KEY / WEBHOOK_SECRET are read from the environment only.
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=

# HTTP port for the gateway server (default 3000).
PORT=3000

# Minimal permission set for the GitHub App (documentation only — not env keys):
#   pull_requests: read
#   contents: read
#   metadata: read
# Webhook events subscribed: pull_request, issue_comment
