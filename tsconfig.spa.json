{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "types": ["vite/client", "bun"],
    "paths": {
      "@/*": ["./src/spa/*"],
      "@design-system": ["./src/design-system/index.ts"]
    }
  },
  // src/design-system lives in this program (not the root one) so React-era
  // primitives and patterns compile with DOM lib; the DOM-free token sources
  // remain reachable from the root program via scripts/** imports. The
  // preview generator and the design-system suite import primitives, so they
  // live here too rather than dragging DOM lib into the worker program.
  "include": [
    "src/spa",
    "src/i18n",
    "src/version.ts",
    "src/design-system",
    "tests/spa",
    "tests/design-system",
    "scripts/build-design-preview.tsx",
  ]
}
