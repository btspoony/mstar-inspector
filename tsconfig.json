{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    // Deliberate mirror of tsconfig.spa.json's paths block: bun test reads
    // only this root tsconfig, so component-level tests resolving the SPA's
    // "@/..." aliases need the mapping here. Root tsc itself is inert for
    // SPA sources (include/exclude below keep src/spa and tests/spa out of
    // the root program) — keep the two paths blocks in sync. Targets are
    // written relative to this file ("."-prefixed): TypeScript 7 accepts no
    // other form and rejects a bare target with TS5090.
    "paths": {
      "@/*": ["./src/spa/*"]
    }
  },
  // `scripts` rides the root program for the same reason `tests` does: a
  // standalone entry point that builds a runtime input must be type-checked
  // against it. Without it, `scripts/live-smoke-evidence.ts` omitted the
  // REQUIRED `AgentRuntimeRunInput.authStorage`, and Bun ran it anyway while
  // `tsc` stayed green — the SDK then recreated the on-disk credential
  // database this codebase removed. Any future omission in scripts/** now
  // fails the same check CI runs.
  "include": ["src", "tests", "scripts"],
  "exclude": ["src/spa", "tests/spa"]
}
