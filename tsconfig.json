{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    // The vendored omp snapshots (scripts/provider-catalog/*.json) are typed
    // runtime inputs: src/dashboard/provider-verify.ts imports the API-key
    // provider union and the `validate "models-endpoint"` entries directly
    // (esbuild/Bun bundle JSON natively; tsc needs this flag to accept it).
    "resolveJsonModule": true,
    // Deliberate mirror of tsconfig.spa.json's paths block: bun test reads
    // only this root tsconfig, so component-level tests resolving the SPA's
    // "@/..." aliases need the mapping here. Root tsc itself is inert for
    // SPA sources (include/exclude below keep src/spa and tests/spa out of
    // the root program) — keep the two paths blocks in sync. Targets are
    // written relative to this file ("."-prefixed): TypeScript 7 accepts no
    // other form and rejects a bare target with TS5090.
    "paths": {
      "@/*": ["./src/spa/*"],
      // The design system's single public entry. No `@design-system/*` mapping:
      // a deep import must fail typecheck, not resolve.
      "@design-system": ["./src/design-system/index.ts"]
    }
  },
  // `scripts` rides the root program for the same reason `tests` does: a
  // standalone entry point that builds a runtime input must be type-checked
  // against it. Without it, `scripts/live-smoke-evidence.ts` omitted the
  // REQUIRED `AgentRuntimeRunInput.authStorage`, and Bun ran it anyway while
  // `tsc` stayed green — the SDK then recreated the on-disk credential
  // database this codebase removed. Any future omission in scripts/** now
  // fails the same check CI runs.
  "include": ["src", "tests", "scripts"],
  // src/design-system rides the SPA program (tsconfig.spa.json) so primitives
  // get DOM lib. `exclude` only drops a path as a root — it does not remove it
  // from the program an import pulls in — so everything that imports a
  // primitive also rides the SPA program: the preview generator (which renders
  // every primitive) and the design-system suite. The DOM-free token sources
  // stay reachable from this program through the imports scripts/** make.
  "exclude": [
    "src/spa",
    "tests/spa",
    "src/design-system",
    "tests/design-system",
    "scripts/build-design-preview.tsx",
  ]
}
