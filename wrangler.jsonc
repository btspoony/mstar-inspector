{
  // 04 skeleton: Worker + KV + Queue producer bindings only.
  // 05 appends d1_databases; 06 appends queues.consumers + sandbox (serial, single file).
  "name": "mstar-inspector",
  "main": "src/worker/entry.ts",
  "compatibility_date": "2026-08-20",
  // 06: nodejs_compat required by the Sandbox container binding (T1-verified).
  "compatibility_flags": ["nodejs_compat"],
  // Bugbot #14: keep dashboard-managed plaintext vars (REVIEW_ENABLED)
  // across automated `wrangler deploy` — without keep_vars, deploy wipes them.
  // (ADMIN_LOGINS is no longer dashboard-managed: the Deploy workflow requires
  // the GitHub Actions variable and injects it with `wrangler deploy --var`.)
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "IDEMPOTENCY_KV",
      "id": "554c5cd446e4401fa878570ac66bbba4"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "REVIEW_QUEUE",
        "queue": "review-queue"
      }
    ],
    // 06: consumer + DLQ. max_batch_size 1 — one review per batch (wall-clock
    // budget per REVIEW_LEVEL: 10 min runner quick/default, 14 min deep
    // in-flight — deep is pinned under the 15 min CF Queue consumer wall-clock
    // cap, src/pipeline/consumer.ts runnerTimeoutMs); failures retry
    // up to max_retries then land in review-dlq. Requires `wrangler queues create review-dlq` before
    // deploy (plan Task 4). The in-flight guard (bugbot PR-3 BB-3) never uses
    // these retries: guard-held jobs are scheduled via per-message
    // `message.retry({ delaySeconds })` (60/120/240s quick/default, 180/360/720s deep — see
    // src/pipeline/consumer.ts guardRetryDelaysSeconds) and finally acked —
    // only REAL processing failures hit max_retries → DLQ.
    "consumers": [
      {
        "queue": "review-queue",
        "max_batch_size": 1,
        // 19 T1 (architect verdict AL-5 — protective fix, NOT explicitizing
        // current behavior): UNSET max_concurrency = the platform
        // auto-scales consumer concurrency by backlog (wrangler 4.125.0
        // schema); today's serial processing is a low-traffic accident.
        // Under scheduling_policy: "durable_object" each attempt's unique
        // sandbox id (src/pipeline/consumer.ts) starts its OWN container —
        // the 0.12 max_instances cap is gone (see the containers comment
        // below), so >1 concurrency runs that many containers at once
        // against the account's container limits, and deep reviews (14 min
        // in-flight) flirt with the 15-min consumer wall-clock cap. Pinned
        // at 1; deliberately NOT env-configurable — raising concurrency is
        // a future explicit decision to be re-validated against the
        // durable-object container model first.
        "max_concurrency": 1,
        "max_retries": 3,
        "dead_letter_queue": "review-dlq"
      }
    ]
  },
  // 19 T1 (architect verdict AL-6): cron failure sweep every 15 min —
  // src/worker/sweep.ts counts review_failures over the trailing 24h (all
  // stages) and alerts past threshold via structured log + optional
  // ALERT_WEBHOOK_URL POST. Read-only: the scheduled handler never mutates
  // queue/KV/D1.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // 05: D1 Central Review Store (binding DB enters the 06 PipelineEnv, not the
  // fetch-face Env — src/worker/env.ts stays untouched).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mstar-inspector-db",
      "database_id": "7a737173-e202-430f-8b47-e087d5e885c4"
    }
  ],
  // 06: Sandbox container binding. Sandbox SDK 1.0 migration (containers
  // guide, migrate-to-durable-object-scheduling-policy): a container
  // application canNOT change its scheduling policy in place or attach to a
  // Durable Object namespace the 0.12-era `Sandbox` application already owns —
  // so the 1.0 implementation is a NEW class (`SandboxV1`,
  // src/pipeline/sandbox.ts) in a NEW namespace, declared through a NEW
  // `new_sqlite_classes` migration tag (v2; the v1 tag is history and stays —
  // src/pipeline/sandbox.ts therefore keeps exporting a minimal compatibility
  // `Sandbox` class, because every fresh worker replays v1).
  // The old `Sandbox` containers entry/binding is therefore REMOVED, not
  // mutated — mutating it would deploy the new Worker version with no
  // durable_object application behind it. The container application name is
  // also new (the account's 0.12-era `mstar-inspector-sandbox` app cannot be
  // reused; it is ORPHANED by this cutover and must be deleted by ops after
  // the switch). `image`, `instance_type`, `max_instances` and
  // `image_build_context` have no equivalent under this policy — the instance
  // size moves into `container.start()` (lite) and concurrency is bounded by
  // the queue consumer's max_concurrency: 1 above. `build_context` "." lets
  // the Dockerfile COPY package.json/bun.lock and src/review into the image
  // (T2 finding). The binding name stays `SANDBOX` so `PipelineEnv` and every
  // consumer call site keep their `env.SANDBOX` usage.
  "containers": [
    {
      "class_name": "SandboxV1",
      "name": "mstar-inspector-sandbox-v2",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": {
          "dockerfile": "./sandbox-image/omp/Dockerfile",
          "build_context": "."
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "SandboxV1",
        "name": "SANDBOX"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["SandboxV1"],
      "tag": "v2"
    }
  ],
  // Observability (dashboard-managed; matched to the live Worker via
  // /workers/scripts/mstar-inspector/settings — verified 2026-09-02).
  // Logs + Traces are the real controls, both enabled + persisted; the legacy
  // top-level `enabled` is what the API returned (false) while the sub-toggles
  // were already ON. Set to true here to reflect the actual state (user turned
  // observability on); sub-toggles below carry the deployed detail 1:1.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  // Vite SPA assets. run_worker_first keeps the Worker as the
  // routing face (SPA_PAGES GET+HTML → index.html; /assets/ files;
  // everything else → legacy Hono). Do NOT set not_found_handling to
  // single-page-application — that would swallow legacy 404s.
  "assets": {
    "directory": "dist/spa",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
