{
  "name": "mstar-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub App inspector gateway (Hono Worker on Cloudflare)",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "review": "bun run src/review/runner.ts",
    "keys": "bun run scripts/provider-keys.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.8",
    "@mstar-harness/engine": "3.5.0",
    "@octokit/auth-app": "8.3.0",
    "@octokit/rest": "22.0.1",
    "@octokit/webhooks": "14.2.0",
    "@oh-my-pi/pi-coding-agent": "18.0.4",
    "hono": "4.13.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260825.1",
    "@types/bun": "1.4.0",
    "typescript": "5.9.3",
    "wrangler": "4.125.0"
  }
}
