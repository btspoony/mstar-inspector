{
  "name": "mstar-inspector",
  "version": "1.0.0-alpha.2",
  "private": true,
  "type": "module",
  "description": "GitHub App inspector gateway (Hono Worker on Cloudflare)",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spa.json",
    "build:spa": "vite build",
    "review": "bun run src/review/runner.ts",
    "release:prepare": "bun run scripts/prepare-release.ts",
    "release:validate": "bun run scripts/validate-release-version.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.0",
    "@mstar-harness/engine": "^4.0.1",
    "@octokit/auth-app": "8.3.1",
    "@octokit/rest": "22.0.1",
    "@octokit/webhooks": "14.2.0",
    "@oh-my-pi/pi-coding-agent": "18.11.1",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "recharts": "2.15.4",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.151.0"
