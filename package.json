{
  "name": "mstar-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub App inspector gateway (Hono Worker on Cloudflare)",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spa.json",
    "build:spa": "vite build",
    "review": "bun run src/review/runner.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.8",
    "@mstar-harness/engine": "3.6.0",
    "@octokit/auth-app": "8.3.0",
    "@octokit/rest": "22.0.1",
    "@octokit/webhooks": "14.2.0",
    "@oh-my-pi/pi-coding-agent": "18.0.4",
    "hono": "4.13.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260825.1",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  }
}
