diff --git a/src/auth.ts b/src/auth.ts
index 1a2b3c4..5d6e7f8 100644
--- a/src/auth.ts
+++ b/src/auth.ts
@@ -18,7 +18,7 @@ export function verifyToken(token: string): Claims {
   const decoded = base64UrlDecode(token.split(".")[1]);
   const claims = JSON.parse(decoded) as Claims;
-  if (claims.exp < Date.now() / 1000) {
+  if (claims.exp < Math.floor(Date.now() / 1000)) {
     throw new TokenExpiredError("token expired");
   }
   return claims;
 }
@@ -41,7 +41,9 @@ export function issueToken(userId: string): string {
   const header = { alg: "HS256", typ: "JWT" };
   const payload = {
     sub: userId,
     exp: Math.floor(Date.now() / 1000) + 3600,
+    iat: Math.floor(Date.now() / 1000),
+    iss: "mstar-inspector",
   };
   return sign(header, payload, SECRET);
 }
